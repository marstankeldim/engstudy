generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ─── Users ───────────────────────────────────────────────────────────
model User {
  id        String   @id // Clerk user ID
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses           Course[]
  quizAttempts      QuizAttempt[]
  flashcardProgress FlashcardProgress[]
  studySessions     StudySession[]
  tutorMessages     TutorMessage[]
}

// ─── Courses ─────────────────────────────────────────────────────────
model Course {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String   @default("#6366f1")
  emoji       String   @default("📚")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents      Document[]
  quizzes        Quiz[]
  flashcardDecks FlashcardDeck[]
  studyGuides    StudyGuide[]
  practiceExams  PracticeExam[]
  tutorMessages  TutorMessage[]
  studySessions  StudySession[]

  @@index([userId])
}

// ─── Documents ───────────────────────────────────────────────────────
model Document {
  id            String         @id @default(cuid())
  courseId      String
  name          String
  fileUrl       String
  fileKey       String         @unique
  fileSize      Int
  mimeType      String
  status        DocumentStatus @default(PROCESSING)
  extractedText String?        @db.Text
  pageCount     Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  course Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@index([courseId])
  @@index([status])
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

model DocumentChunk {
  id         String                       @id @default(cuid())
  documentId String
  content    String                       @db.Text
  chunkIndex Int
  embedding  Unsupported("vector(1536)")?
  tokenCount Int?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ─── Quizzes ─────────────────────────────────────────────────────────
model Quiz {
  id          String     @id @default(cuid())
  courseId    String
  title       String
  description String?
  difficulty  Difficulty @default(MEDIUM)
  timeLimit   Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@index([courseId])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id             String       @id @default(cuid())
  quizId         String?
  practiceExamId String?
  type           QuestionType
  content        String       @db.Text
  options        Json?
  correctAnswer  String
  explanation    String?      @db.Text
  points         Int          @default(1)
  order          Int

  quiz         Quiz?         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  practiceExam PracticeExam? @relation(fields: [practiceExamId], references: [id], onDelete: Cascade)
  answers      Answer[]

  @@index([quizId])
  @@index([practiceExamId])
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  userId      String
  score       Int?
  totalPoints Int?
  completed   Boolean   @default(false)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([quizId, userId])
}

model Answer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  userAnswer String
  isCorrect  Boolean

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ─── Flashcards ──────────────────────────────────────────────────────
model FlashcardDeck {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cards  Flashcard[]

  @@index([courseId])
}

model Flashcard {
  id     String   @id @default(cuid())
  deckId String
  front  String   @db.Text
  back   String   @db.Text
  tags   String[]
  order  Int

  deck     FlashcardDeck       @relation(fields: [deckId], references: [id], onDelete: Cascade)
  progress FlashcardProgress[]

  @@index([deckId])
}

// SM-2 spaced repetition state per user per card
model FlashcardProgress {
  id          String    @id @default(cuid())
  userId      String
  flashcardId String
  easeFactor  Float     @default(2.5)
  interval    Int       @default(1)
  repetitions Int       @default(0)
  nextReview  DateTime  @default(now())
  lastReview  DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
}

// ─── Study Guides ─────────────────────────────────────────────────────
model StudyGuide {
  id        String         @id @default(cuid())
  courseId  String
  title     String
  content   String         @db.Text
  type      StudyGuideType
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

enum StudyGuideType {
  SUMMARY
  EXAM_REVIEW
  FORMULA_SHEET
  KEY_TAKEAWAYS
}

// ─── Practice Exams ───────────────────────────────────────────────────
model PracticeExam {
  id         String     @id @default(cuid())
  courseId   String
  title      String
  difficulty Difficulty
  timeLimit  Int
  createdAt  DateTime   @default(now())

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([courseId])
}

// ─── AI Tutor ────────────────────────────────────────────────────────
model TutorMessage {
  id        String      @id @default(cuid())
  userId    String
  courseId  String
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
}

enum MessageRole {
  USER
  ASSISTANT
}

// ─── Progress / Analytics ────────────────────────────────────────────
model StudySession {
  id        String      @id @default(cuid())
  userId    String
  courseId  String?
  type      SessionType
  duration  Int?
  startedAt DateTime    @default(now())
  endedAt   DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
}

enum SessionType {
  QUIZ
  FLASHCARDS
  STUDY_GUIDE
  TUTOR
  PRACTICE_EXAM
}
