# ─── Database ──────────────────────────────────────────────────────────
# PostgreSQL with the pgvector extension available.
# Recommended: Neon (https://neon.tech) — free tier supports pgvector.
# Use the POOLED connection string for the app at runtime.
DATABASE_URL="postgresql://user:password@host/engstudy?sslmode=require"

# ─── Clerk Authentication ──────────────────────────────────────────────
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx
# Create a webhook (see README) and paste its signing secret here
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── OpenAI ────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxx

# ─── UploadThing ───────────────────────────────────────────────────────
# https://uploadthing.com/dashboard → API Keys
UPLOADTHING_TOKEN=xxxxxxxxxxxx

# ─── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
